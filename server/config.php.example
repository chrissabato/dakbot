<?php
// Copy this file to config.php and fill in your broker credentials.
define('MQTT_HOST', 'localhost');
define('MQTT_PORT', 1883);
define('MQTT_USER', 'browser');
define('MQTT_PASS', 'changeme');

// Where mqtt-cache-daemon.php writes the live per-device state and api.php
// reads it from. Kept outside the web root (one level above this file) so
// it isn't served as a static file. The daemon creates this path if needed.
define('CACHE_FILE', __DIR__ . '/../dakbot-cache/devices.json');

// Devices are dropped from api.php's response once they haven't published
// for this long, and flagged 'stale' (greyed out on the dashboard) once
// they haven't published for DEVICE_STALE_SECONDS.
define('DEVICE_STALE_SECONDS', 24 * 60 * 60);
define('DEVICE_EXPIRE_SECONDS', 7 * 24 * 60 * 60);
